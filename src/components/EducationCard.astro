---
import type { Education } from '../types';

interface Props {
  ed: Education;
}

const { ed }: Props = Astro.props;
---

<div class="block-card">
  <div class="block-title-row">
    <h3>{ed.school}</h3>
    <span class="dates">{ed.dates}</span>
  </div>
  <p class="role">{ed.degree}</p>
  <ul>
    {(ed.bullets || []).map((bullet) => <li>{bullet}</li>)}
    {ed.dissertation && <li>Dissertation: <i>{ed.dissertation}</i>.</li>}
  </ul>
</div>
