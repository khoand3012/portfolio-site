---
const { job } = Astro.props;
---

<div class="block-card">
  <div class="block-title-row">
    <h3>{job.company}</h3>
    <span class="dates">{job.dates}</span>
  </div>
  {job.role && <p class="role">{job.role}</p>}
  {job.bullets?.length > 0 && (
    <ul>
      {job.bullets.map((bullet) => <li>{bullet}</li>)}
    </ul>
  )}
</div>
