---
// tabs: [{ slug, label }], in display order. First one starts active.
interface Props {
  tabs: { slug: string; label: string }[];
}

const { tabs }: Props = Astro.props;
---

<nav class="tabs">
  <div class="wrap">
    {tabs.map((t, i) => (
      <button class={`tab-btn${i === 0 ? ' active' : ''}`} data-tab={t.slug}>{t.label}</button>
    ))}
  </div>
</nav>
